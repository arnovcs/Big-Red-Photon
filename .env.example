# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouteService
ORS_API_KEY=
ORS_BASE_URL=

# Google Places API (New): all venues and typed places (required)
GOOGLE_PLACES_API_KEY=
# Google Routes API (all modes, live traffic for driving; ORS is the fallback):
# PROVIDER_ROUTING=google. Empty = use the Places key.
GOOGLE_ROUTES_API_KEY=

# Capital One Nessie
NESSIE_API_KEY=
NESSIE_BASE_URL=

# Bridge <-> backend
BRIDGE_URL=
BACKEND_URL=

# Photon project: the bridge (bridge/.env) and, for web signup, the backend
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_API_URL=
# Photon account token from `npx @photon-ai/cli login` (web signup invites)
PHOTON_TOKEN=
PHOTON_DASHBOARD_URL=

# Database
DATABASE_URL=

# Providers: photon|sim, google (places: only option), google|ors|mock, nessie
PROVIDER_MESSAGING=
PROVIDER_PLACES=
PROVIDER_ROUTING=
PROVIDER_FINANCE=

# Record/replay: off|record|replay
CACHE_MODE=

# Demo area
DEMO_TIMEZONE=
DEMO_AREA_LABEL=
DEMO_CENTER_LAT=
DEMO_CENTER_LNG=

# Own car
DRIVE_COST_PER_MILE_USD=
DRIVE_PARKING_USD=

# Ride-share
RIDESHARE_BASE_USD=
RIDESHARE_BOOKING_USD=
RIDESHARE_PER_MILE_USD=
RIDESHARE_PER_MIN_USD=
RIDESHARE_MIN_FARE_USD=
RIDESHARE_PICKUP_WAIT_MIN=

# Tuning
OPTIMIZER_LAMBDA=
POLL_TIMEOUT_SEC=

# Timeouts
LLM_TIMEOUT_SEC=
HTTP_TIMEOUT_SEC=

# Web signup
APP_NAME=
BOT_PHONE_NUMBER=
PHOTON_CAN_INITIATE=
SIGNUP_TOKEN_TTL_HOURS=
